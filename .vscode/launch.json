{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug STM32F412 (GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/avionique/Avionique.elf",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "arm-none-eabi-gdb",
            "miDebuggerServerAddress": "localhost:3333",
            "stopAtEntry": true,
            "externalConsole": false,
            "logging": {
                "engineLogging": false,
                "moduleLoad": false,
                "programOutput": true,
                "trace": false
            },
            "preLaunchTask": "Build Avionique",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Connect to GDB server",
                    "text": "target extended-remote localhost:3333",
                    "ignoreFailures": false
                },
                {
                    "description": "Load executable",
                    "text": "load",
                    "ignoreFailures": false
                },
                {
                    "description": "Reset and halt the target",
                    "text": "monitor reset halt",
                    "ignoreFailures": false
                }
            ],
            "customLaunchSetupCommands": [],
            "launchCompleteCommand": "exec-continue"
        },
        {
            "name": "Debug STM32F412 (GDB - Manual Connect)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/avionique/Avionique.elf",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "arm-none-eabi-gdb",
            "stopAtEntry": true,
            "externalConsole": false,
            "logging": {
                "engineLogging": false,
                "moduleLoad": false,
                "programOutput": true,
                "trace": false
            },
            "preLaunchTask": "Build Avionique",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "customLaunchSetupCommands": [],
            "launchCompleteCommand": "None"
        },
        {
            "name": "Attach STM32F412 (GDB)",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/build/avionique/Avionique.elf",
            "MIMode": "gdb",
            "miDebuggerPath": "arm-none-eabi-gdb",
            "miDebuggerServerAddress": "localhost:3333",
            "logging": {
                "engineLogging": false,
                "moduleLoad": false,
                "programOutput": true,
                "trace": false
            },
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}