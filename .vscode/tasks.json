{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Avionique",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", 
                "${workspaceFolder}/build/avionique",
                "--config",
                "Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Build the STM32F412 Avionique project using CMake"
        },
        {
            "label": "Configure CMake",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset=avionique"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": [],
            "detail": "Configure CMake with the avionique preset"
        },
        {
            "label": "Clean Build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", 
                "${workspaceFolder}/build/avionique",
                "--target", 
                "clean"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": [],
            "detail": "Clean the build directory"
        },
        {
            "label": "Start GDB Server (ST-Link)",
            "type": "shell",
            "command": "st-util",
            "args": [
                "-p", "3333"
            ],
            "group": "build",
            "isBackground": true,
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": false
            },
            "problemMatcher": [
                {
                    "pattern": [
                        {
                            "regexp": ".*",
                            "file": 1,
                            "location": 2,
                            "message": 3
                        }
                    ],
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": ".*",
                        "endsPattern": "Listening at \\*:3333\\.\\.\\."
                    }
                }
            ],
            "detail": "Start ST-Link GDB server on port 3333"
        },
        {
            "label": "Start GDB Server (OpenOCD)",
            "type": "shell",
            "command": "openocd",
            "args": [
                "-f", "interface/stlink.cfg",
                "-f", "target/stm32f4x.cfg"
            ],
            "group": "build",
            "isBackground": true,
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": false
            },
            "problemMatcher": [
                {
                    "pattern": [
                        {
                            "regexp": ".*",
                            "file": 1,
                            "location": 2,
                            "message": 3
                        }
                    ],
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": ".*",
                        "endsPattern": "Info : Listening on port 3333 for gdb connections"
                    }
                }
            ],
            "detail": "Start OpenOCD GDB server for STM32F4"
        }
    ]
}